# ============================================================================
# WashUp - Konfigurasi Environment Supabase (Modul 4: Database & Autentikasi)
# Salin file ini menjadi `.env` di direktori root proyek WashUp, lalu isi
# dengan Project URL dan Anon Public Key dari Dashboard Supabase Anda:
# Project Settings -> API -> Project URL & Project API Keys (anon / public)
# ============================================================================

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
